# 复制为 .env，并填写真实值。不要提交 .env。

# ===== 数据库（PostgreSQL / Neon，必填）=====
# Neon：Connection Details > Pooled connection string（主机名通常以 -pooler 结尾）
# sslmode 显式写 verify-full：pg v9 起 require 会退化成 libpq 语义（不校验证书），verify-full 才是当前的强校验行为
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full"

# ===== Auth.js（AUTH_SECRET 必填）=====
# 生成密钥：openssl rand -base64 32
AUTH_SECRET=""
# 生产环境默认不信任 Host 头。自托管需要信任时设为 true。
AUTH_TRUST_HOST="false"
# X-Forwarded-For 右侧需要跳过的代理地址数（不是连接总跳数）。
# 平台覆写为单个客户端地址时可设 0；自托管必须确保入口清洗/追加该头，且后端不可直连。
TRUSTED_PROXY_HOPS="0"

# ===== 站点地址（生产必填，用于 sitemap/RSS/元数据与验证邮件链接）=====
NEXT_PUBLIC_SITE_URL=""

# ===== 超级管理员（运行种子脚本前必填）=====
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ===== 注册邮件（QQ SMTP；未配置则无法提交申请）=====
# SMTP_PASS 是 QQ 邮箱授权码，不是 QQ 密码。
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ===== hCaptcha（可选；未配置时跳过验证）=====
# Site Key：在 https://dashboard.hcaptcha.com 创建站点后获取。该值公开，用于前端。
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
# Secret Key：在同一后台获取。该值仅供服务端校验，必须保密。
HCAPTCHA_SECRET_KEY=""

# ===== 图片存储（Vercel Blob）=====
# 未配置时写入 public/uploads，由 Next.js 提供静态访问。
# 生产环境上传封面或头像时必须配置持久化存储，否则本地文件可能丢失。
# 在 Vercel 项目的 Storage 中创建 Blob Store 后，此变量会自动注入。
BLOB_READ_WRITE_TOKEN=""
