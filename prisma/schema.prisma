// PostgreSQL 数据模型；生产环境使用 Neon。

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 用户：role 取值 SUPER_ADMIN | ADMIN | MEMBER（游客无账号记录）
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt 哈希
  sessionVersion Int @default(0)
  image     String?
  role      String   @default("MEMBER")
  // 账号激活时间（审核通过时间）；null 表示待审核（邀请码路径提交时建号待激活）
  activatedAt DateTime?
  // 激活后未首次登录则禁用：普通申请 7 天，邀请码申请 14 天。
  disabled  Boolean  @default(false)
  // 禁言：mutedDuring 为截止时间（定时禁言）；mutedPermanent 为永久禁言；mutedReason 为原因
  mutedDuring    DateTime?
  mutedPermanent Boolean  @default(false)
  mutedReason    String?
  // 首次登录时间，用于账号回收判定。
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 显示偏好：字体缩放（0.8~1.2）+ 页面间距（0.8~1.2）+ 界面密度（compact/normal/comfortable/custom）
  // 默认存 localStorage，开启跨设备同步后持久化到账号
  fontScale    Float?
  spacingScale Float? // 页面间距倍率
  density      String?
  headerH      Int? // 自定义密度：导航栏高度 px
  footerPy     Int? // 自定义密度：页脚间距 px
  // 视觉动效偏好（跨设备同步）
  waveIntensity Float? // 远山水墨强度 0~1.5
  inkEnabled    Boolean? // 水墨墨迹开关
  reduceMotion  Boolean? // 减少动效开关
  // 阅读体验偏好（跨设备同步）
  proseLeading    Float? // 正文行距 1.5~2.2
  smoothScroll    Boolean? // 平滑滚动开关
  readingProgress Boolean? // 阅读进度条开关

  posts        Post[]
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]
  readingLogs  ReadingLog[]
  inviteCodeId String?
  inviteCode   InviteCode?   @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  notifications Notification[]
}

// 文章分类（一篇文章属于一个分类）
model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  posts       Post[]
}

// 文章系列/专题（一篇多集内容归入同一系列，如「Next.js 教程」）
model Series {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  createdAt   DateTime @default(now())
  posts       Post[]
}

// 标签（与文章多对多）
model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

// 文章：content 为 Markdown 文本
// 状态语义：published=false 为草稿(DRAFT)；published=true 且 archived=false 为已发布(PUBLISHED)；archived=true 为已归档(ARCHIVED)
model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime? // 首次发布时间
  archived    Boolean   @default(false)
  pinned      Boolean   @default(false) // 置顶（列表页排最前）
  featured    Boolean   @default(false)
  viewCount   Int       @default(0)
  wordCount   Int?      // 纯文字字数（保存时计算，页脚只做 sum 加法，避免实时读全文）
  searchText  String?   // 搜索索引正文（去 Markdown 后完整保存，搜索时不再回读 content）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  seriesId   String?
  series     Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  tags       PostTag[]
  comments   Comment[]
  likes      Like[]
  bookmarks  Bookmark[]
  readingLogs ReadingLog[]
  revisions  PostRevision[]

  @@index([published, createdAt])
  @@index([published, archived, createdAt])
  @@index([categoryId])
  @@index([seriesId, createdAt])
  @@index([viewCount, createdAt])
}

// 文章-标签 中间表
model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// 评论：审核制（isApproved 默认 false），parentId 支持嵌套回复
model Comment {
  id         String   @id @default(cuid())
  content    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([postId, isApproved])
  @@index([parentId])
  @@index([postId, createdAt])
  @@index([isApproved, createdAt])
}

// 点赞：一个用户对一篇文章只能赞一次
model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
}

// 收藏：一个用户对一篇文章只能收藏一次（书签）
model Bookmark {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
}

// 阅读记录：登录用户读过的文章（去重），wordCount 为首次阅读时该文章的字数快照，
// 供个人页「累计阅读字数」聚合；同一文章重复阅读不重复计数
model ReadingLog {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

// 每日浏览量为趋势提供时间维度；评论、点赞和注册按 createdAt 推算。
// date 为东八区日键 YYYY-MM-DD（避免 UTC 切日导致北京时间 08:00 才翻页）
model DailyViewStat {
  date      String   @id
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// 账号申请：status 取值 PENDING | PROCESSING | APPROVED | REJECTED
// password 在审核交付期间暂存加密密文，失败重试复用同一凭据，通过后清空
model AccountRequest {
  id        String   @id @default(cuid())
  email     String
  message   String?
  password  String?
  kind      String   @default("STANDARD")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

// 邀请码：游客可凭码申请账号（仍走审核），格式 XR-XX-xxxxxxxxxxxx
// maxUses 为使用次数上限，usedCount 为已用次数；usedBy 记录通过该码注册的用户
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  usedBy    User[]
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

// 角色权限配置：role 为角色，permissions 存 JSON 数组（如 ["comment","like"]）
// 超级管理员固定全开不在此表；未配置的角色回落到代码默认值，新增权限零迁移成本
model RolePermission {
  role        String   @id
  permissions String // JSON 数组字符串
  updatedAt   DateTime @updatedAt
}

// 限流计数：key 为限流维度（如 login:email:ip），固定窗口计数，多实例共享（生产用 Postgres）
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// 站内通知：category 为分类（system 系统 / like 赞 / comment 评论与回复），type 为细分事件
// 接收者 userId 为该通知的所属用户（管理员收到审核类通知，普通用户收到审核结果通知）
// actorName 为最近一位触发者昵称快照（点赞/评论者），系统类通知为空
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   @default("system")
  type      String
  actorName String?
  title     String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // lastMergedAt 用于聚合窗口和排序；createdAt 仅用于 7 天清理。
  lastMergedAt DateTime @default(now())

  // 点赞通知聚合：
  // aggregateKey 相同、未读且在聚合窗口（24h）内的通知合并为同一条，避免刷屏
  aggregateKey String?
  // 去重后的触发者昵称 JSON 数组，最新在前，最多 20 个
  actorNames   String?
  // 聚合的事件总次数（同一人反复触发也会累加；条数永远只占一行）
  count        Int      @default(1)

  @@index([userId, category, read, createdAt])
  @@index([userId, read, createdAt])
  @@index([userId, aggregateKey, read])
  @@index([userId, lastMergedAt, id])
  @@index([userId, aggregateKey, read, lastMergedAt])
}

// 文章版本快照：每次保存前记录旧状态，支持历史查看与回滚
// tags 存标签名 JSON 数组字符串（如 ["Next.js","前端"]）
model PostRevision {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title      String
  slug       String
  content    String
  excerpt    String?
  coverImage String?
  categoryId String?
  seriesId   String?
  tags       String // JSON 数组
  published  Boolean
  pinned     Boolean
  featured   Boolean
  archived   Boolean
  authorId   String?
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}
